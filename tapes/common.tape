# Shared look for every demo. Sourced by the other tapes.
Set Shell bash
Set FontSize 15
Set Padding 18
Set Margin 0
Set TypingSpeed 45ms
Set Framerate 12
Set Theme { "name": "moe", "background": "#0d1117", "foreground": "#d6dde8", "cursor": "#e0973a", "selection": "#243044", "black": "#0d1117", "red": "#e05561", "green": "#17b3a3", "yellow": "#e0973a", "blue": "#5b8def", "magenta": "#c678dd", "cyan": "#17b3a3", "white": "#d6dde8", "brightBlack": "#5d6878", "brightRed": "#e05561", "brightGreen": "#17b3a3", "brightYellow": "#e0973a", "brightBlue": "#5b8def", "brightMagenta": "#c678dd", "brightCyan": "#17b3a3", "brightWhite": "#ffffff" }
