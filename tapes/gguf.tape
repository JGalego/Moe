# A GGUF checkpoint, read in place.
#   vhs tapes/gguf.tape
Source common.tape
Output assets/gguf.gif
Set Width 1240
Set Height 420

Hide
Type "PS1='$ ' && clear" Enter
Show

Type "moe info Qwen/Qwen1.5-MoE-A2.7B-Chat-GGUF"
Sleep 700ms
Enter
Sleep 18s

Type "moe run Qwen/Qwen1.5-MoE-A2.7B-Chat-GGUF -n 24 \"
Enter
Type "  -p 'A sparse model is fast because'"
Sleep 700ms
Enter
Sleep 20s
